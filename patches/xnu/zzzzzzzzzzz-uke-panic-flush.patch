@@ -164,6 +164,11 @@ check_for_panic_log(void)
 #endif /* DEVELOPMENT && defined(XNU_TARGET_OS_BRIDGE) */
 
 #endif
+	/* A panic-time staging block (UkeLastLog's UKE_PANIC_SAVE_MAGIC) is consumed
+	 * by the log writer: keep it instead of clearing the pram. */
+	if (((const uint32_t *)(uintptr_t)gPanicBase)[0] == 0x31564153u) {
+		return;
+	}
 	panic_info = (struct embedded_panic_header *)gPanicBase;
 
 	/* Check if a shared memory console is running in the panic buffer */
